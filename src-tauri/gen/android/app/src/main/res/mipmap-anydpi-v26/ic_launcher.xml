<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptives Symbol. Beide Ebenen sind 108dp gross, sichtbar ist nur der
  mittlere Bereich: Android legt je nach Hersteller eine runde oder
  abgerundete Maske darueber. Der Hintergrund darf deshalb beschnitten
  werden, er ist ueberall gleich; der Inhalt sitzt im sicheren Bereich.
  Erzeugt aus derselben Vorlage wie das iOS-Symbol.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
