# Vorlage. Kopiere diese Datei nach `keystore.properties` und trage deine
# Werte ein. Die Kopie ist von der .gitignore ausgeschlossen und bleibt auf
# deinem Rechner; diese Vorlage hier enthaelt bewusst keine echten Werte.
#
#   cp keystore.properties.example keystore.properties
#
# Ohne `keystore.properties` signiert der Release-Bau mit dem
# Debug-Schluessel von Android. Das reicht zum Aufspielen per Kabel, aber
# nicht fuer den Play Store.
#
# Den Schluessel selbst legst du an mit:
#
#   keytool -genkey -v -keystore ~/sanwissen.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias sanwissen
#
# Bewahre die .jks-Datei sicher auf und sichere sie. Sie ist die Identitaet
# der App: ohne sie laesst sich keine Aktualisierung mehr veroeffentlichen,
# und ein neuer Schluessel bedeutet eine neue App im Store.

storeFile=/Users/DEIN_NAME/sanwissen.jks
storePassword=
keyAlias=sanwissen
keyPassword=
