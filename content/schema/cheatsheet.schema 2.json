{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cheatsheet.schema.json",
  "title": "Cheat-Sheet",
  "description": "Stark verkürzte Merkzettel. moduleId/itemId verlinken zurück ins Quellmodul.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "moduleId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "sourceNote": {
            "type": "string",
            "minLength": 1,
            "description": "Worauf der Eintrag beruht. Ein Eintrag ohne Quellenhinweis ist unvollständig."
          }
        },
        "required": [
          "id",
          "title",
          "icon",
          "points",
          "moduleId",
          "itemId",
          "sourceNote"
        ]
      }
    }
  },
  "required": [
    "cards"
  ]
}
