{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modules.schema.json",
  "title": "Modul-Registry",
  "description": "Titel, Kategorie und Symbole aller Module. Die Zuordnung zur Komponente steht im Code.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "Grundlagenwissen",
          "Krankheitsbilder & Algorithmen",
          "Medikamente",
          "Diagnostik & Training",
          "Einsatz & Organisation"
        ]
      },
      "description": "Reihenfolge der Kategorien in Seitenleiste und Fahrplan."
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "symbol": {
            "type": "string",
            "description": "SF Symbol (iOS)."
          },
          "icon": {
            "type": "string",
            "description": "Emoji (Desktop-Seitenleiste)."
          },
          "category": {
            "enum": [
              "Grundlagenwissen",
              "Krankheitsbilder & Algorithmen",
              "Medikamente",
              "Diagnostik & Training",
              "Einsatz & Organisation"
            ]
          },
          "pinned": {
            "type": "boolean",
            "description": "Fest oben, außerhalb der Kategorien."
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "symbol",
          "icon",
          "category",
          "pinned",
          "available"
        ]
      }
    }
  },
  "required": [
    "categories",
    "modules"
  ]
}
