{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checklisten.schema.json",
  "title": "Checklisten",
  "description": "Abhakbare Listen für den Dienst, aus den Themenmodulen abgeleitet.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "checklists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sourceNote": {
            "type": "string",
            "minLength": 1,
            "description": "Worauf der Eintrag beruht. Ein Eintrag ohne Quellenhinweis ist unvollständig."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "sourceNote",
          "items"
        ]
      }
    }
  },
  "required": [
    "checklists"
  ]
}
