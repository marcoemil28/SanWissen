{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "werkzeuge.schema.json",
  "title": "Werkzeuge & Scores",
  "description": "Nur die Metadaten. Die Rechner selbst sind Code und brauchen je einen case in WerkzeugeView.swift.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "contentStand": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Datum der letzten inhaltlichen Prüfung, ISO (JJJJ-MM-TT)."
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sourceNote": {
            "type": "string",
            "minLength": 1,
            "description": "Worauf der Eintrag beruht. Ein Eintrag ohne Quellenhinweis ist unvollständig."
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "description",
          "sourceNote"
        ]
      }
    }
  },
  "required": [
    "contentStand",
    "tools"
  ]
}
