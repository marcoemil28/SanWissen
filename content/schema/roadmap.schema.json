{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap.schema.json",
  "title": "Fahrplan",
  "description": "Kuratierte Verlinkung je Themenkategorie. Keine eigenen Inhalte.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "Grundlagenwissen",
              "Krankheitsbilder & Algorithmen",
              "Medikamente",
              "Diagnostik & Training",
              "Einsatz & Organisation"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "moduleId": {
                  "type": "string"
                },
                "itemId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "moduleId",
                "itemId",
                "label"
              ]
            }
          }
        },
        "required": [
          "category",
          "entries"
        ]
      }
    }
  },
  "required": [
    "sections"
  ]
}
