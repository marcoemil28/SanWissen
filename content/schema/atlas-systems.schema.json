{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-systems.schema.json",
  "title": "Organsysteme des 3D-Atlas",
  "description": "Namen, Farben und Beschreibungen der Organsysteme. Die ids müssen zu den Werten des Feldes `system` in content/atlas/atlas.json passen; das prüft scripts/check-content.mjs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "filters": {
      "type": "array",
      "description": "Reiter über der Systemliste.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "systems": {
            "type": "array",
            "description": "Systeme, die der Reiter zeigt. Fehlt das Feld, zeigt er alle.",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "label"]
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Muss einem `system` in atlas.json entsprechen."
          },
          "name": { "type": "string" },
          "hex": {
            "type": "string",
            "description": "Grundfarbe der Netze dieses Systems.",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": { "type": "string" },
          "femaleDescription": {
            "type": "string",
            "description": "Abweichende Beschreibung für das weibliche Modell. Fehlt sie, gilt `description`."
          },
          "hiddenByDefault": {
            "type": "boolean",
            "description": "Zu Beginn ausgeblendet. Die Körperoberfläche würde sonst alles darunter verdecken."
          }
        },
        "required": ["id", "name", "hex", "description"]
      }
    }
  },
  "required": ["filters", "systems"]
}
