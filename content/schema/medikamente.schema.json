{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medikamente.schema.json",
  "title": "Medikamente (SAA/BPR)",
  "description": "Aus docs/saa_bpr_2025.pdf extrahiert, ergänzt um die Kurzbeschreibung unter \"wirkung\".",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Verweis auf dieses Schema. Nur für den Editor, die Apps ignorieren das Feld."
    },
    "contentStand": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Datum der letzten inhaltlichen Prüfung, ISO (JJJJ-MM-TT)."
    },
    "categoryOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medikamente": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "wirkstoff": {
            "type": [
              "string",
              "null"
            ]
          },
          "konzentration": {
            "type": [
              "string",
              "null"
            ]
          },
          "wirkung": {
            "type": "string",
            "description": "Ergänztes Pharmakologie-Wissen, steht nicht im Original-PDF."
          },
          "arzneimittelgruppe": {
            "type": "string"
          },
          "indikationen": {
            "type": "string"
          },
          "kontraindikationen": {
            "type": [
              "string",
              "null"
            ]
          },
          "relativeKontraindikationen": {
            "type": [
              "string",
              "null"
            ]
          },
          "dosierung": {
            "type": "string"
          },
          "altersbegrenzung": {
            "type": "string"
          },
          "uaw": {
            "type": "string",
            "description": "Unerwünschte Arzneimittelwirkungen."
          },
          "ueberdosierung": {
            "type": [
              "string",
              "null"
            ]
          },
          "besonderheiten": {
            "type": [
              "string",
              "null"
            ]
          },
          "besondereHinweise": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": "integer",
            "description": "Seitenzahl in SAA und BPR 2025."
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "wirkstoff",
          "konzentration",
          "wirkung",
          "arzneimittelgruppe",
          "indikationen",
          "kontraindikationen",
          "relativeKontraindikationen",
          "dosierung",
          "altersbegrenzung",
          "uaw",
          "ueberdosierung",
          "besonderheiten",
          "besondereHinweise",
          "page"
        ]
      }
    }
  },
  "required": [
    "contentStand",
    "categoryOrder",
    "medikamente"
  ]
}
